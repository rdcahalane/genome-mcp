{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rdcahalane/genome-industrial-intelligence",
  "title": "Genome Industrial Intelligence",
  "description": "Industrial intelligence for AI agents. Conviction scores and diligence for 10,000+ industrials.",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/rdcahalane/genome-mcp/main/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "genome-industrial-intelligence",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "env": [
        {
          "name": "GENOME_COMMERCIAL_KEY",
          "description": "API key for Genome Industrial Intelligence. Purchase at studio.civops.io/dealmakers",
          "required": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://genome-api.civops.io/mcp"
    }
  ],
  "repository": {
    "url": "https://github.com/rdcahalane/genome-mcp",
    "source": "github"
  },
  "websiteUrl": "https://studio.civops.io/dealmakers"
}
